{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Sleep Analysis",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--input", "sleep_data.asc",
        "--delimiter", "whitespace",
        "--has-header",
        "--eeg-col", "EEG_Hz",
        "--emg-col", "EMG_mV",
        "--fs", "1.0",
        "--epoch-sec", "2",
        "--out-prefix", "results/test_run"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
